# Copy to .env.local and fill in. NEVER commit real values or paste them into chat.
# Find them in your Supabase project's API keys settings.

# --- Browser-safe (public) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (older projects: the "anon" key works here too)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Where the app runs; used to build sign-in links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets: never import in client code ---------------------
# The "secret" key (older projects: the "service_role" key). Used only by
# scripts/invite-volunteer.mts and, later, the email worker. Bypasses RLS.
SUPABASE_SECRET_KEY=
APP_ENV=development            # development | staging | production

# --- Email (Phase 6), with sending OFF by default --------------------------
EMAIL_SENDING_ENABLED=false
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_STAGING_ALLOWLIST=        # comma-separated; only these receive mail outside production

# --- Outbox / reminder worker (Phase 6) ------------------------------------
CRON_SECRET=

# --- Tests only ------------------------------------------------------------
# Postgres superuser URL for the throwaway test databases (local, never production)
TEST_PG_ADMIN_URL=postgresql://postgres@localhost:54329/postgres?host=/tmp
