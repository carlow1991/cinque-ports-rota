# Copy to .env.local and fill in. Never commit real values.
# Public (browser-visible) Supabase settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: never import in client code
SUPABASE_SERVICE_ROLE_KEY=
APP_ENV=development            # development | staging | production

# Email (Phase 6), with sending OFF by default
EMAIL_SENDING_ENABLED=false
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_STAGING_ALLOWLIST=        # comma-separated; only these receive mail outside production

# Outbox / reminder worker (Phase 6)
CRON_SECRET=
