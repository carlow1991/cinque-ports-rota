# Copy to .env.local and fill in. NEVER commit real values or paste them into chat.
# Find them in your Supabase project's API keys settings.

# --- Browser-safe (public) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (older projects: the "anon" key works here too)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Where the app runs; used to build sign-in links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets: never import in client code ---------------------
# The "secret" key (older projects: the "service_role" key). Used only by
# scripts/invite-volunteer.mts, Auth invites and the email worker (which the
# database limits to the four outbox functions).
SUPABASE_SECRET_KEY=
# development | staging | pilot | production. Only "production" emails everyone; "pilot" is the
# live site during the volunteer pilot, emailing only EMAIL_STAGING_ALLOWLIST (the pilot group).
APP_ENV=development
# Supabase Auth invitation emails from /manage/volunteers. Keep false until the pilot is approved;
# admins can still add people and invite them with scripts/invite-volunteer.mts.
AUTH_INVITES_ENABLED=false

# --- Email (Phase 6), with sending OFF by default --------------------------
# Nothing is sent unless this is exactly "true" AND the three values below are set.
EMAIL_SENDING_ENABLED=false
EMAIL_PROVIDER_API_KEY=         # Resend API key (server only)
EMAIL_FROM_ADDRESS=             # e.g. Cinque Ports FC Rota <rota@your-verified-club-domain>
# Unless APP_ENV=production, ONLY these addresses receive email; all others are suppressed.
EMAIL_STAGING_ALLOWLIST=        # comma-separated
# EMAIL_API_BASE_URL=           # tests only (points at the fake provider); leave unset

# --- Outbox / reminder worker (Phase 6) ------------------------------------
# Long random value (at least 16 characters). The scheduler sends
# "Authorization: Bearer <CRON_SECRET>" to /api/cron/outbox.
CRON_SECRET=

# --- Tests only ------------------------------------------------------------
# Postgres superuser URL for the throwaway test databases (local, never production)
TEST_PG_ADMIN_URL=postgresql://postgres@localhost:54329/postgres?host=/tmp
